<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>BallYstik — 20 Arènes uniques</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { width: 100%; height: 100%; overflow: hidden; background: #050508; font-family: system-ui, sans-serif; }

  #grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
    padding: 6px;
    width: 100vw;
    height: 100vh;
    overflow-y: auto;
    overflow-x: hidden;
    align-content: start;
  }
  .tile {
    position: relative;
    width: 100%;
    padding-bottom: 177.78%;
    border-radius: 6px;
    overflow: hidden;
    cursor: pointer;
    background: #000;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .tile:hover { transform: scale(1.03); box-shadow: 0 0 24px rgba(255,255,255,0.2); z-index: 2; }
  .tile canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .tile .label {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 3px 5px;
    font-size: 10px;
    color: #eee;
    background: linear-gradient(transparent, rgba(0,0,0,0.9));
    text-align: center;
    z-index: 2;
    pointer-events: none;
  }

  #fullscreen { position: fixed; inset: 0; z-index: 100; background: #000; display: none; }
  #fullscreen.active { display: block; }
  #fullscreen canvas { width: 100vw; height: 100vh; display: block; }

  #closeBtn {
    position: fixed; top: 12px; right: 12px; z-index: 101;
    background: rgba(0,0,0,0.7); color: #fff;
    border: 1px solid #444; padding: 8px 14px;
    border-radius: 6px; cursor: pointer; font-size: 13px;
    display: none;
  }
  #closeBtn.active { display: block; }
  #closeBtn:hover { background: rgba(40,40,40,0.9); }
</style>
</head>
<body>

<div id="grid"></div>
<div id="fullscreen"><canvas id="fsCanvas"></canvas></div>
<button id="closeBtn">✕ Fermer</button>

<script>
// ============================================================
// PRELUDE COMMUN
// ============================================================
const PRELUDE = `
precision highp float;
varying vec2 vUV;
uniform float uTime;
uniform vec2 uRes;

float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float hash3(vec3 p) { return fract(sin(dot(p, vec3(12.9898, 78.233, 45.164))) * 43758.5453); }
float noise(vec2 p) {
  vec2 i = floor(p), f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  return mix(mix(hash(i), hash(i+vec2(1,0)), f.x), mix(hash(i+vec2(0,1)), hash(i+vec2(1,1)), f.x), f.y);
}
float noise3(vec3 p) {
  vec3 i = floor(p), f = fract(p);
  f = f*f*(3.0-2.0*f);
  return mix(mix(mix(hash3(i), hash3(i+vec3(1,0,0)), f.x),
                 mix(hash3(i+vec3(0,1,0)), hash3(i+vec3(1,1,0)), f.x), f.y),
             mix(mix(hash3(i+vec3(0,0,1)), hash3(i+vec3(1,0,1)), f.x),
                 mix(hash3(i+vec3(0,1,1)), hash3(i+vec3(1,1,1)), f.x), f.y), f.z);
}
float fbm(vec2 p) {
  float s = 0.0, a = 0.5;
  for (int i = 0; i < 5; i++) { s += a * noise(p); p *= 2.03; a *= 0.5; }
  return s;
}
float fbm3(vec3 p) {
  float s = 0.0, a = 0.5;
  for (int i = 0; i < 4; i++) { s += a * noise3(p); p *= 2.05; a *= 0.5; }
  return s;
}
float sdRoundRect(vec2 p, vec2 b, float r) {
  vec2 q = abs(p) - b + r;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}
float sdHexagon(vec2 p, float r) {
  vec3 k = vec3(-0.8660254, 0.5, 0.57735);
  p = abs(p);
  p -= 2.0 * min(dot(k.xy, p), 0.0) * k.xy;
  p -= vec2(clamp(p.x, -k.z*r, k.z*r), r);
  return length(p) * sign(p.y);
}
float sdDiamond(vec2 p, float r) { return abs(p.x) + abs(p.y) - r; }
float sdCross(vec2 p, vec2 b, float t) {
  vec2 q = abs(p);
  vec2 c = vec2(min(q.x, q.y), max(q.x, q.y));
  float d = max(c.x - t, c.y - b.y);
  return length(max(vec2(d, c.y - b.y), 0.0)) + min(max(d, c.y - b.y), 0.0);
}
float sdSeg(vec2 p, vec2 a, vec2 b, float r) {
  vec2 pa = p - a, ba = b - a;
  float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
  return length(pa - ba * h) - r;
}
vec2 aspectUV() {
  vec2 a = vec2(9.0 / 16.0, 1.0);
  return (vUV - 0.5) * a + 0.5;
}
float vignette(vec2 uv) {
  return 1.0 - length((uv - 0.5) * vec2(0.85, 1.0)) * 0.7;
}
`;

// ============================================================
// SHADERS
// ============================================================
const SH_NEON_GRID = PRELUDE + `
void main() {
  vec2 uvA = aspectUV(); vec2 p = uvA - 0.5;
  vec3 col = vec3(0.04, 0.04, 0.08);
  vec2 g = abs(fract(uvA * 10.0) - 0.5);
  col += vec3(0.0, 0.9, 1.0) * smoothstep(0.48, 0.5, max(g.x, g.y)) * 0.15;
  vec2 g2 = abs(fract(uvA * 20.0) - 0.5);
  col += vec3(0.0, 0.5, 0.7) * smoothstep(0.48, 0.5, max(g2.x, g2.y)) * 0.06;
  col += vec3(0.0, 0.3, 0.5) * (sin(length(p) * 12.0 - uTime * 2.0) * 0.5 + 0.5) * 0.05;
  col += vec3(0.0, 0.9, 1.0) * smoothstep(0.005, 0.0, abs(sdRoundRect(p, vec2(0.44), 0.06))) * 0.9;
  for (int i = 0; i < 3; i++) {
    float fi = float(i);
    vec2 oc = vec2(0.3 + 0.4*hash(vec2(fi,1.0)), 0.3 + 0.4*hash(vec2(fi,2.0))) - 0.5;
    float or_ = 0.05 + 0.03*hash(vec2(fi,3.0));
    float d = length(p - oc) - or_;
    col = mix(col, vec3(0.05,0.1,0.15), smoothstep(0.005, 0.0, d));
    col += vec3(0.0,0.9,1.0) * smoothstep(0.008, 0.0, abs(d)) * 0.7;
  }
  col *= vignette(uvA);
  gl_FragColor = vec4(col, 1.0);
}
`;

const SH_HEXAGON = PRELUDE + `
void main() {
  vec2 uvA = aspectUV(); vec2 p = uvA - 0.5;
  vec3 col = vec3(0.03, 0.02, 0.06);
  vec2 hp = p * 8.0;
  vec2 a = mod(hp, vec2(1.732, 1.0)) - 0.5;
  vec2 b = mod(hp + vec2(0.866, 0.5), vec2(1.732, 1.0)) - 0.5;
  float hexLine = smoothstep(0.45, 0.5, min(abs(a.x), abs(b.x)));
  float inHex = smoothstep(0.005, 0.0, sdHexagon(p, 0.44));
  col += vec3(0.6, 0.3, 1.0) * hexLine * inHex * 0.15;
  col += vec3(0.5, 0.2, 0.9) * (1.0 - smoothstep(0.0, 0.5, length(p))) * 0.08;
  col += vec3(0.7, 0.3, 1.0) * (sin(p.y * 30.0 - uTime * 2.0) * 0.5 + 0.5) * 0.03 * inHex;
  col += vec3(0.7, 0.4, 1.0) * smoothstep(0.008, 0.0, abs(sdHexagon(p, 0.44))) * 1.2;
  for (int i = 0; i < 4; i++) {
    float fi = float(i);
    float ang = fi * 1.5708 + uTime * 0.1;
    vec2 oc = vec2(cos(ang), sin(ang)) * (0.22 + 0.06*sin(fi*2.0));
    float d = sdHexagon(p - oc, 0.05);
    col = mix(col, vec3(0.1,0.05,0.15), smoothstep(0.005, 0.0, d));
    col += vec3(1.0,0.5,1.0) * smoothstep(0.01, 0.0, abs(d)) * 0.8;
  }
  col *= vignette(uvA);
  gl_FragColor = vec4(col, 1.0);
}
`;

const SH_CIRCUS = PRELUDE + `
void main() {
  vec2 uvA = aspectUV(); vec2 p = uvA - 0.5;
  vec3 col = vec3(0.06, 0.04, 0.02);
  float r = length(p);
  col += vec3(0.9, 0.6, 0.2) * (sin(r * 40.0 - uTime * 1.5) * 0.5 + 0.5) * 0.08 * smoothstep(0.5, 0.0, r);
  float ang = atan(p.y, p.x);
  col += vec3(0.7, 0.4, 0.1) * (sin(ang * 16.0 + uTime * 0.5) * 0.5 + 0.5) * 0.04;
  col += vec3(0.3, 0.2, 0.1) * fbm(p * 8.0 + uTime * 0.05) * 0.1;
  col += vec3(1.0, 0.7, 0.3) * smoothstep(0.008, 0.0, abs(r - 0.44)) * 1.3;
  for (int i = 0; i < 4; i++) {
    float ri = 0.46 + float(i) * 0.025;
    col += vec3(0.5, 0.3, 0.1) * smoothstep(0.003, 0.0, abs(r - ri)) * 0.4;
  }
  for (int i = 0; i < 3; i++) {
    float fi = float(i);
    float a2 = fi * 2.094 + uTime * 0.2;
    vec2 oc = vec2(cos(a2), sin(a2)) * 0.22;
    float d = length(p - oc) - 0.05;
    col = mix(col, vec3(0.15, 0.1, 0.05), smoothstep(0.005, 0.0, d));
    col += vec3(1.0, 0.6, 0.2) * smoothstep(0.008, 0.0, abs(d)) * 0.6;
  }
  col *= vignette(uvA);
  gl_FragColor = vec4(col, 1.0);
}
`;

const SH_CROSS = PRELUDE + `
void main() {
  vec2 uvA = aspectUV(); vec2 p = uvA - 0.5;
  vec3 col = vec3(0.02, 0.02, 0.03);
  vec2 chk = floor(p * 16.0);
  col += vec3(0.1, 0.05, 0.1) * mod(chk.x + chk.y, 2.0) * 0.15;
  float inCross = smoothstep(0.005, 0.0, sdCross(p, vec2(0.44), 0.16));
  col = mix(col * 0.3, col, inCross);
  col += vec3(0.9, 0.1, 0.4) * (1.0 - smoothstep(0.0, 0.3, length(p))) * inCross * 0.1;
  float diag = abs(fract((p.x + p.y) * 8.0) - 0.5);
  col += vec3(1.0, 0.1, 0.3) * smoothstep(0.48, 0.5, diag) * inCross * 0.15;
  col += vec3(1.0, 0.15, 0.4) * smoothstep(0.008, 0.0, abs(sdCross(p, vec2(0.44), 0.16))) * 1.2;
  for (int i = 0; i < 4; i++) {
    float fi = float(i);
    vec2 o = vec2(fi < 2.0 ? -0.3 : 0.3, mod(fi, 2.0) < 0.5 ? 0.15 : -0.15);
    float d = sdRoundRect(p - o, vec2(0.08, 0.03), 0.01);
    col = mix(col, vec3(0.05,0.02,0.05), smoothstep(0.005, 0.0, d));
    col += vec3(1.0, 0.2, 0.4) * smoothstep(0.008, 0.0, abs(d)) * 0.7;
  }
  col *= vignette(uvA);
  gl_FragColor = vec4(col, 1.0);
}
`;

const SH_DIAMOND = PRELUDE + `
void main() {
  vec2 uvA = aspectUV(); vec2 p = uvA - 0.5;
  vec3 col = vec3(0.02, 0.03, 0.06);
  vec2 tp = p * 12.0;
  float tri = 0.0;
  for (int i = 0; i < 3; i++) {
    vec2 q = tp + vec2(float(i) * 0.577, float(i) * 0.333);
    vec2 f = abs(fract(q) - 0.5);
    tri = max(tri, smoothstep(0.48, 0.5, max(f.x, f.y)));
  }
  col += vec3(0.1, 0.6, 1.0) * tri * 0.1;
  float inDiamond = smoothstep(0.005, 0.0, sdDiamond(p, 0.45));
  col += vec3(0.05, 0.15, 0.3) * inDiamond;
  col += vec3(0.2, 0.7, 1.0) * (sin(p.y * 80.0 + uTime * 3.0) * 0.5 + 0.5) * 0.03 * inDiamond;
  col += vec3(0.3, 0.8, 1.0) * smoothstep(0.008, 0.0, abs(sdDiamond(p, 0.45))) * 1.2;
  for (int i = 0; i < 3; i++) {
    float fi = float(i);
    vec2 oc = vec2(0.0, (fi - 1.0) * 0.2);
    vec2 q = p - oc;
    q.x = abs(q.x);
    float d = max(q.x * 0.866 + q.y * 0.5, -q.y) - 0.04;
    d = max(d, -q.x * 0.866 + q.y * 0.5);
    col = mix(col, vec3(0.02,0.05,0.1), smoothstep(0.005, 0.0, d));
    col += vec3(0.3,0.8,1.0) * smoothstep(0.008, 0.0, abs(d)) * 0.8;
  }
  col *= vignette(uvA);
  gl_FragColor = vec4(col, 1.0);
}
`;

const SH_ROTATING = PRELUDE + `
mat2 rot(float a) { float c = cos(a), s = sin(a); return mat2(c, -s, s, c); }
void main() {
  vec2 uvA = aspectUV(); vec2 p = uvA - 0.5;
  vec3 col = vec3(0.03, 0.03, 0.02);
  vec2 g = abs(fract(p * 15.0) - 0.5);
  col += vec3(0.6, 0.5, 0.1) * smoothstep(0.48, 0.5, max(g.x, g.y)) * 0.08;
  col += vec3(1.0, 0.85, 0.2) * smoothstep(0.006, 0.0, abs(sdRoundRect(p, vec2(0.44), 0.0))) * 1.0;
  for (int i = 0; i < 4; i++) {
    float fi = float(i);
    float a = fi * 1.5708 + uTime * 0.6;
    vec2 rp = rot(a) * p;
    float d = sdRoundRect(rp - vec2(0.22, 0.0), vec2(0.14, 0.015), 0.008);
    col = mix(col, vec3(0.15, 0.1, 0.02), smoothstep(0.005, 0.0, d));
    col += vec3(1.0, 0.9, 0.3) * smoothstep(0.008, 0.0, abs(d)) * 0.8;
  }
  col += vec3(1.0, 0.6, 0.1) * (1.0 - smoothstep(0.0, 0.06, length(p))) * 0.3;
  col *= vignette(uvA);
  gl_FragColor = vec4(col, 1.0);
}
`;

const SH_VORTEX = PRELUDE + `
void main() {
  vec2 uvA = aspectUV(); vec2 p = uvA - 0.5;
  float r = length(p);
  float a = atan(p.y, p.x);
  vec3 col = vec3(0.05, 0.01, 0.08);
  col += vec3(0.6, 0.1, 1.0) * (sin(a * 6.0 + r * 25.0 - uTime * 3.0) * 0.5 + 0.5) * 0.15 * smoothstep(0.5, 0.0, r);
  col += vec3(0.9, 0.3, 1.0) * (1.0 - smoothstep(0.0, 0.15, r)) * 0.4;
  for (int i = 0; i < 12; i++) {
    float fi = float(i);
    float pa = fi * 0.52 + uTime * 2.0;
    float pr = fract(hash(vec2(fi, 0.0)) + uTime * 0.15) * 0.45;
    vec2 pp = vec2(cos(pa), sin(pa)) * pr;
    col += vec3(0.8, 0.4, 1.0) * smoothstep(0.006, 0.0, length(p - pp)) * 0.7;
  }
  col += vec3(0.8, 0.4, 1.0) * smoothstep(0.008, 0.0, abs(r - 0.44)) * 1.2;
  col *= vignette(uvA);
  gl_FragColor = vec4(col, 1.0);
}
`;

const SH_MAZE = PRELUDE + `
void main() {
  vec2 uvA = aspectUV(); vec2 p = uvA - 0.5;
  vec3 col = vec3(0.03, 0.03, 0.04);
  vec2 brick = vec2(p.x * 8.0, p.y * 16.0);
  vec2 bi = floor(brick);
  if (mod(bi.y, 2.0) > 0.5) brick.x += 0.5;
  vec2 bf = fract(brick);
  float mortar = smoothstep(0.45, 0.48, max(abs(bf.x - 0.5), abs(bf.y - 0.5)));
  col += vec3(0.15, 0.1, 0.08) * (1.0 - mortar) * 0.3;
  col += vec3(0.9, 0.7, 0.4) * smoothstep(0.006, 0.0, abs(sdRoundRect(p, vec2(0.44), 0.0))) * 0.8;
  float d = 1e5;
  d = min(d, sdSeg(p, vec2(-0.2,-0.2), vec2(-0.2, 0.1), 0.012));
  d = min(d, sdSeg(p, vec2(-0.2, 0.1), vec2(0.05, 0.1), 0.012));
  d = min(d, sdSeg(p, vec2(0.2, 0.2), vec2(0.2,-0.1), 0.012));
  d = min(d, sdSeg(p, vec2(0.2,-0.1), vec2(-0.05,-0.1), 0.012));
  d = min(d, sdSeg(p, vec2(0.0,-0.35), vec2(0.0,-0.05), 0.012));
  d = min(d, sdSeg(p, vec2(0.0, 0.35), vec2(0.0, 0.05), 0.012));
  col = mix(col, vec3(0.08,0.06,0.05), smoothstep(0.005, 0.0, d));
  col += vec3(1.0, 0.75, 0.4) * smoothstep(0.008, 0.0, abs(d)) * 0.6;
  col *= vignette(uvA);
  gl_FragColor = vec4(col, 1.0);
}
`;

const SH_ISLANDS = PRELUDE + `
void main() {
  vec2 uvA = aspectUV(); vec2 p = uvA - 0.5;
  vec3 col = vec3(0.02, 0.05, 0.1);
  col += vec3(0.05, 0.2, 0.35) * fbm(p * 4.0 + uTime * 0.15) * 0.4;
  col += vec3(0.2, 0.5, 0.7) * (sin(p.y * 40.0 + uTime * 2.0 + sin(p.x * 20.0) * 2.0) * 0.5 + 0.5) * 0.06;
  for (int i = 0; i < 4; i++) {
    float fi = float(i);
    vec2 o = vec2(fi < 2.0 ? -0.22 : 0.22, mod(fi, 2.0) < 0.5 ? 0.18 : -0.18);
    float ir = 0.11 + 0.01 * sin(uTime + fi);
    float d = length(p - o) - ir;
    col = mix(col, vec3(0.6, 0.5, 0.3) + fbm((p - o) * 20.0) * 0.15, smoothstep(0.005, 0.0, d));
    col += vec3(0.9, 0.7, 0.4) * smoothstep(0.006, 0.0, abs(d)) * 0.6;
  }
  float b1 = sdRoundRect(p - vec2(0.0, 0.18), vec2(0.12, 0.015), 0.008);
  float b2 = sdRoundRect(p - vec2(0.0, -0.18), vec2(0.12, 0.015), 0.008);
  float b3 = sdRoundRect(p - vec2(0.22, 0.0), vec2(0.015, 0.07), 0.008);
  float b4 = sdRoundRect(p - vec2(-0.22, 0.0), vec2(0.015, 0.07), 0.008);
  float bd = min(min(b1, b2), min(b3, b4));
  col = mix(col, vec3(0.4, 0.3, 0.15), smoothstep(0.005, 0.0, bd));
  col += vec3(0.9, 0.7, 0.4) * smoothstep(0.008, 0.0, abs(bd)) * 0.5;
  col += vec3(0.4, 0.6, 1.0) * smoothstep(0.006, 0.0, abs(sdRoundRect(p, vec2(0.44), 0.04))) * 0.8;
  col *= vignette(uvA);
  gl_FragColor = vec4(col, 1.0);
}
`;

const SH_PIXEL = PRELUDE + `
void main() {
  vec2 res = vec2(120.0, 213.0);
  vec2 uvP = floor(vUV * res) / res;
  vec2 uvA = (uvP - 0.5) * vec2(9.0/16.0, 1.0) + 0.5;
  vec2 p = uvA - 0.5;
  vec3 col = vec3(0.02, 0.02, 0.05);
  vec2 g = abs(fract(p * 20.0) - 0.5);
  col += vec3(0.4, 0.2, 0.8) * smoothstep(0.4, 0.5, max(g.x, g.y)) * 0.2;
  col += vec3(1.0, 0.8, 0.2) * smoothstep(0.01, 0.0, abs(sdRoundRect(p, vec2(0.44), 0.0))) * 1.0;
  for (int i = 0; i < 3; i++) {
    float fi = float(i);
    vec2 o = vec2((fi - 1.0) * 0.18, mod(fi, 2.0) < 0.5 ? 0.15 : -0.15);
    float d = sdRoundRect(p - o, vec2(0.06, 0.06), 0.0);
    col = mix(col, vec3(0.15, 0.05, 0.3), smoothstep(0.005, 0.0, d));
    col += vec3(1.0, 0.5, 0.9) * smoothstep(0.01, 0.0, abs(d)) * 0.8;
  }
  for (int i = 0; i < 8; i++) {
    float fi = float(i);
    vec2 sp = vec2(hash(vec2(fi,1.0))-0.5, hash(vec2(fi,2.0))-0.5) * 0.8;
    col += vec3(1.0, 1.0, 0.5) * smoothstep(0.015, 0.0, length(p - sp)) * (sin(uTime * 3.0 + fi * 2.0) * 0.5 + 0.5) * 0.7;
  }
  col *= vignette(uvA);
  gl_FragColor = vec4(col, 1.0);
}
`;

const SH_HOLO = PRELUDE + `
void main() {
  vec2 uvA = aspectUV(); vec2 p = uvA - 0.5;
  vec3 col = vec3(0.01, 0.03, 0.06);
  col += vec3(0.2, 0.9, 1.0) * (sin((vUV.y + uTime * 0.3) * 200.0) * 0.5 + 0.5) * 0.05;
  for (int i = 0; i < 6; i++) {
    float fi = float(i);
    float y = -0.4 + fi * 0.16 + sin(uTime + fi) * 0.02;
    col += vec3(0.2, 0.9, 1.0) * smoothstep(0.003, 0.0, abs(p.y - y)) * 0.15;
  }
  for (int i = 0; i < 6; i++) {
    float fi = float(i);
    float x = -0.4 + fi * 0.16;
    col += vec3(0.2, 0.9, 1.0) * smoothstep(0.003, 0.0, abs(p.x - x)) * 0.15;
